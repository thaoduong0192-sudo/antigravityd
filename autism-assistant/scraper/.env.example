# Google Spreadsheet ID (from the URL: .../spreadsheets/d/{ID}/edit)
SPREADSHEET_ID=1ABCdefGHIjkl...

# Path to Google Cloud service account JSON key
# Download from: Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON
# Then share the spreadsheet with the service account email (editor access)
GOOGLE_CREDENTIALS_PATH=./credentials/service-account.json
